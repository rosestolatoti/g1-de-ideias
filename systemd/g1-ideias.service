# /etc/systemd/system/g1-ideias.service — G1 DE IDEIAS (Mint 22.3)
# Instale: sudo cp systemd/g1-ideias.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now g1-ideias
[Unit]
Description=G1 DE IDEIAS — Flask profissional (Fábio Rosestolato)
After=network.target network-online.target
Wants=network-online.target

[Service]
User=fabiorjvr
Group=fabiorjvr
WorkingDirectory=/home/fabiorjvr/g1-ideias
Environment=FLASK_ENV=production
Environment=TYPESAFE_API_KEY=apikey_211fcd85e979fe84c7b8425070fc1bd43ac_9179835f795abbcd48f0d7e29994b624be334e36d16859d15def821f88be3251
Environment=PORT=5000
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/python3 -m gunicorn -c gunicorn.conf.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=10

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=g1-ideias

[Install]
WantedBy=multi-user.target
