# G1 DE IDEIAS — .env.example
# Copie para .env e preencha: cp .env.example .env

# === Flask ===
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=troque-esta-chave-segura-aqui
PORT=5000
HOST=0.0.0.0

# === JEV / TypeSafe (obrigatório para peneira inteligente) ===
# Pegue em https://typesafe.ai — já está em /tmp/typesafe-lab/.env.secure e /root/.hermes/.env
# 107 chars começando com apikey_
TYPESAFE_API_KEY=apikey_xxx

# === Paths ===
SCREENSHOTS_DIR=/storage/emulated/0/Pictures/Screenshots
DATA_JSON=data/noticias.json
PRINTS_CROPPED=prints/cropped
PRINTS_ORIGINAL=prints/original

# === Crop padrão Moto g84 5G 1080x2400 ===
CROP_TOP=110
CROP_BOTTOM=48

# === JEV thresholds (calibráveis) ===
JEV_SCORE_MIN=1.0
JEV_UTIL_MIN=0.55
JEV_BATCH_SIZE=8

# === Deploy ===
VERCEL_TOKEN=vercel_xxx
CLOUDFLARE_API_TOKEN=cf_xxx
CLOUDFLARE_ZONE_ID=xxx

# === GitHub ===
GITHUB_TOKEN=ghp_xxx

# === ADB ===
ADB_TARGET=127.0.0.1:5555
